# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, used by cron routes. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Random secret string — set the same value in Vercel env vars and
# in the Authorization header Vercel Cron sends (configured automatically
# when using vercel.json crons on a project with this env var set).
CRON_SECRET=generate-a-random-string-here

# WhatsApp Business Platform (Meta Cloud API). Optional for now — if unset,
# the send-reminders cron runs in dry-run mode: it does everything except
# the actual network call, so the rest of the pipeline stays testable.
# Get these from Meta Business Manager once WhatsApp Business Platform
# access is set up (see README).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=medication_reminder

# Optional — powers real semantic search on the Documents page. Without
# this, search falls back to plain keyword matching (still fully
# functional, just not semantic). Get a key from platform.openai.com.
OPENAI_API_KEY=